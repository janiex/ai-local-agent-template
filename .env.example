# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust. All values have sane defaults.
# ---------------------------------------------------------------------------

# Which LLM backend the agent talks to: "ollama" (local) or "anthropic" (API).
LLM_PROVIDER=ollama

# --- Local LLM (Ollama) -----------------------------------------------------
# Requires Ollama running locally: https://ollama.com  (then `ollama pull <model>`)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14B #llama3.1

# --- External LLM (Anthropic Claude API) ------------------------------------
# Get a key at https://console.anthropic.com . Needs `pip install anthropic`.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Agent loop -------------------------------------------------------------
# Maximum reason -> act -> observe iterations before the agent must answer.
AGENT_MAX_STEPS=8

# --- Skills -----------------------------------------------------------------
# Where to discover SKILL.md skill folders. Empty = the project's `skills/` dir.
# SKILLS_DIR=/path/to/custom/skills
